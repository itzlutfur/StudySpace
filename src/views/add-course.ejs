<%- include('partials/head', { title, theme: typeof theme !== 'undefined' ? theme : 'dark', pageScript: '/js/add-course.js' }) %>

<section class="hero">
  <div>
    <h1>Add a course</h1>
    <p class="muted">Choose the folder that contains your downloaded course files.</p>
  </div>
</section>

<!-- Step 1: choose a folder -->
<section class="panel" id="step-pick">
  <h2 class="panel-title">1 · Locate the course folder</h2>

  <label class="field">
    <span class="field-label">Folder path</span>
    <input type="text" id="path-input" class="input" placeholder="D:\Downloads\my-course"
           value="<%= initialPath %>" spellcheck="false" autocomplete="off">
  </label>

  <div class="row-actions">
    <button class="btn" id="browse-btn" type="button">Browse…</button>
    <button class="btn btn-primary" id="scan-btn" type="button">Scan folder</button>
  </div>

  <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Drop a course folder here">
    <p><strong>or drag a course folder here</strong></p>
    <p class="muted small">
      Browsers cannot read a dropped folder's location for security reasons — drop it here and
      paste the path shown in your file manager.
    </p>
  </div>

  <div class="alert alert-error" id="scan-error" hidden></div>

  <div class="subfolders" id="subfolders" hidden>
    <h3 class="muted small">Subfolders — add one of these as its own course</h3>
    <div class="chip-row" id="subfolder-list"></div>
  </div>
</section>

<!-- Step 2: review the detected lessons -->
<section class="panel" id="step-review" hidden>
  <h2 class="panel-title">2 · Review <span id="review-total"></span></h2>

  <label class="field">
    <span class="field-label">Course title</span>
    <input type="text" id="title-input" class="input" placeholder="Course title">
  </label>

  <div class="scan-summary" id="scan-summary"></div>
  <div class="alert alert-warn" id="scan-warnings" hidden></div>

  <div class="review-list" id="review-list"></div>

  <div class="row-actions row-actions-end">
    <button class="btn" id="back-btn" type="button">Back</button>
    <button class="btn btn-primary" id="add-btn" type="button">Add to library</button>
  </div>
</section>

<!-- Folder picker modal -->
<div class="modal-backdrop" id="browse-modal" hidden>
  <div class="modal modal-lg" role="dialog" aria-modal="true" aria-labelledby="browse-title">
    <div class="modal-head">
      <h2 id="browse-title">Browse for a folder</h2>
      <button class="btn btn-icon" id="browse-close" type="button" aria-label="Close">✕</button>
    </div>
    <div class="browse-roots" id="browse-roots"></div>
    <div class="breadcrumbs" id="breadcrumbs"></div>
    <div class="browse-list" id="browse-list"></div>
    <div class="modal-foot">
      <span class="muted small" id="browse-current"></span>
      <div class="row-actions">
        <button class="btn" id="browse-cancel" type="button">Cancel</button>
        <button class="btn btn-primary" id="browse-choose" type="button">Use this folder</button>
      </div>
    </div>
  </div>
</div>

<!-- Remove-course confirmation modal -->
<div class="modal-backdrop" id="confirm-modal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <div class="modal-head">
      <h2 id="confirm-title">Remove course?</h2>
    </div>
    <div class="modal-body">
      <p id="confirm-message"></p>
      <p class="muted small">This deletes its progress, bookmarks and notes. The files on disk are not touched.</p>
    </div>
    <div class="modal-foot">
      <div class="row-actions">
        <button class="btn" id="confirm-cancel" type="button">Cancel</button>
        <button class="btn btn-danger" id="confirm-ok" type="button">Remove course</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
