<%- include('partials/head', { title, theme: typeof theme !== 'undefined' ? theme : 'dark', pageScript: '/js/course.js' }) %>

<nav class="crumbs"><a href="/">Library</a> <span>/</span> <span class="muted"><%= course.title %></span></nav>

<section class="course-header">
  <div>
    <h1><%= course.title %></h1>
    <p class="muted path" title="<%= course.root_path %>"><%= course.root_path %></p>
  </div>
  <div class="course-header-actions">
    <% if (course.resumeLessonId) { %>
    <a class="btn btn-primary" href="/player/<%= course.resumeLessonId %>?resume=1">Resume ▸</a>
    <% } %>
    <button class="btn" id="rescan-btn" type="button">Rescan</button>
    <button class="btn btn-danger-ghost" id="remove-btn" type="button">Remove</button>
  </div>
</section>

<section class="stat-strip">
  <div class="stat">
    <span class="stat-value"><%= course.stats.percent %>%</span>
    <span class="stat-label">complete</span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= course.stats.completed %> / <%= course.stats.counted %></span>
    <span class="stat-label">lessons</span>
  </div>
  <div class="stat">
    <span class="stat-value"><%= course.stats.averagePercent %>%</span>
    <span class="stat-label">watched</span>
  </div>
  <div class="stat progress-stat">
    <div class="progress-track"><div class="progress-fill" style="width:<%= course.stats.percent %>%"></div></div>
  </div>
</section>

<% if (course.stats.missing > 0) { %>
<div class="alert alert-warn">
  <%= course.stats.missing %> file<%= course.stats.missing === 1 ? ' is' : 's are' %> missing from disk.
  These lessons are excluded from your progress percentage. Use <strong>Rescan</strong> to refresh.
</div>
<% } %>

<section class="lesson-groups">
  <% grouped.forEach(function (group) { %>
  <div class="lesson-group">
    <h2 class="group-title">
      <%= group.name || 'Lessons' %>
      <span class="count-pill"><%= group.lessons.length %></span>
    </h2>
    <ul class="lesson-list">
      <% group.lessons.forEach(function (lesson) { %>
      <% const p = course.progressByLessonId.get(lesson.id); const done = p && (p.completed || (p.watched_pct || 0) >= 0.9); %>
      <li class="lesson-item <%= lesson.missing ? 'is-missing' : '' %>">
        <a href="/player/<%= lesson.id %>" class="lesson-link">
          <span class="lesson-check <%= done ? 'done' : '' %>" aria-hidden="true"><%= done ? '✓' : '' %></span>
          <span class="lesson-title"><%= lesson.title %></span>
          <% if (lesson.warn) { %><span class="warn small" title="<%= lesson.warn %>">⚠</span><% } %>
          <% if (lesson.missing) { %><span class="badge badge-warn">missing</span><% } %>
          <span class="lesson-type"><%= lesson.type %></span>
          <% if (p && p.position_sec > 5 && !done) { %>
          <span class="lesson-resume muted small">resume <%= Math.floor(p.position_sec / 60) %>:<%= String(Math.floor(p.position_sec % 60)).padStart(2, '0') %></span>
          <% } %>
        </a>
      </li>
      <% }) %>
    </ul>
  </div>
  <% }) %>
</section>

<div class="modal-backdrop" id="confirm-modal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
    <div class="modal-head"><h2 id="confirm-title">Remove course?</h2></div>
    <div class="modal-body">
      <p id="confirm-message"></p>
      <p class="muted small">This deletes its progress, bookmarks and notes. The files on disk are not touched.</p>
    </div>
    <div class="modal-foot">
      <div class="row-actions">
        <button class="btn" id="confirm-cancel" type="button">Cancel</button>
        <button class="btn btn-danger" id="confirm-ok" type="button">Remove course</button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
